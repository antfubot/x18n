{
  "name": "x18n",
  "type": "module",
  "version": "0.0.0",
  "description": "Manage and view i18n files of any project, for humans and agents",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/x18n.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/antfu/x18n/issues",
  "keywords": [
    "i18n",
    "cli",
    "locale",
    "translation"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "x18n": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x18n/core": "workspace:*",
    "cac": "catalog:deps"
  }
}
